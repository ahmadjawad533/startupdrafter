{
  "name": "standup-drafter",
  "version": "1.0.0",
  "description": "StandupDrafter - Transform informal work notes into professional status updates using AWS and AI",
  "bin": {
    "standup-drafter": "bin/standup-drafter.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:frontend": "jest tests/test_frontend.test.js --testPathPattern=frontend",
    "test:infrastructure": "jest test/standup-drafter-stack.test.ts --testPathPattern=infrastructure",
    "test:coverage": "jest --coverage",
    "cdk": "cdk"
  },
  "keywords": [
    "aws-cdk",
    "serverless",
    "ai",
    "bedrock"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.133.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.133.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
